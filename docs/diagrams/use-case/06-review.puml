@startuml
left to right direction
skinparam packageStyle rectangle
skinparam usecaseBackgroundColor #F5F9FF
skinparam usecaseBorderColor #4774A5
title Use Case PBL6 — Đánh giá
actor "Người truy cập" as Visitor
actor "Khách vãng lai" as Guest
actor "Khách hàng" as Customer
actor "Quản trị viên" as Admin
Guest --|> Visitor
Customer --|> Visitor
rectangle "PBL6 Marketplace" {
  usecase "Xem review và điểm tổng hợp\n[UC-REV-BROWSE]" as UC_REV_BROWSE
  usecase "Đánh giá OrderItem đã hoàn tất\n[UC-REV-CREATE]" as UC_REV_CREATE
  usecase "Sửa đánh giá của mình\n[UC-REV-EDIT]" as UC_REV_EDIT
  usecase "Ẩn hoặc hiện lại đánh giá\n[UC-REV-MODERATE]" as UC_REV_MODERATE
}
Visitor -- UC_REV_BROWSE
Customer -- UC_REV_CREATE
Customer -- UC_REV_EDIT
Admin -- UC_REV_MODERATE
@enduml
