@startuml
left to right direction
skinparam packageStyle rectangle
skinparam usecaseBackgroundColor #F5F9FF
skinparam usecaseBorderColor #4774A5
title Use Case PBL6 — Đơn hàng và hoàn tiền Customer
actor "Khách hàng" as Customer
rectangle "PBL6 Marketplace" {
  usecase "Xem danh sách, chi tiết và tracking đơn của mình\n[UC-ORDER-LIST]" as UC_ORDER_LIST
  usecase "Hủy một Order còn cho phép\n[UC-ORDER-CANCEL]" as UC_ORDER_CANCEL
  usecase "Xem trạng thái hoàn tiền mock\n[UC-REFUND-TRACK]" as UC_REFUND_TRACK
}
Customer -- UC_ORDER_LIST
Customer -- UC_ORDER_CANCEL
Customer -- UC_REFUND_TRACK
@enduml
