{
  "version": "1.0",
  "events": {
    "ProductChanged": {
      "schema": {
        "type": "object",
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "event_type": {
            "type": "string",
            "enum": [
              "ProductChanged"
            ]
          },
          "schema_version": {
            "type": "string",
            "enum": [
              "1.0"
            ]
          },
          "producer": {
            "type": "string",
            "enum": [
              "M1"
            ]
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "correlation_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-]{1,64}$",
            "maxLength": 200
          },
          "payload": {
            "type": "object",
            "properties": {
              "product_id": {
                "type": "string",
                "format": "uuid"
              },
              "store_id": {
                "type": "string",
                "format": "uuid"
              },
              "version": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "sale_status": {
                "type": "string",
                "enum": [
                  "DRAFT",
                  "ACTIVE",
                  "STOPPED"
                ]
              },
              "moderation_status": {
                "type": "string",
                "enum": [
                  "VISIBLE",
                  "HIDDEN"
                ]
              }
            },
            "required": [
              "product_id",
              "store_id",
              "version",
              "sale_status",
              "moderation_status"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "event_id",
          "event_type",
          "schema_version",
          "producer",
          "occurred_at",
          "correlation_id",
          "payload"
        ],
        "additionalProperties": false
      },
      "producers": [
        "M1"
      ],
      "consumers": [
        "M4"
      ],
      "source": "Catalog mutation outbox; refresh current product prices via M1",
      "consumer_policy": "inbox dedup + effect in one transaction; M4 verifies current consent; stale versions do not overwrite newer data"
    },
