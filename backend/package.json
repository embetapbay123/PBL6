{
  "name": "pbl6-backend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:m1": "npm run build && node dist/catalog-service/src/main.js",
    "dev:m2": "npm run build && node dist/commerce-service/src/main.js",
    "dev:m3": "npm run build && node dist/identity-store-service/src/main.js",
    "migration": "tsx shared/src/migrate.ts",
    "seed": "tsx shared/src/seed.ts",
    "worker": "tsx shared/src/worker.ts",
    "test": "jest --runInBand",
    "test:integration": "jest --runInBand --config jest.integration.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "bcryptjs": "^3.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0",
    "typeorm": "^0.3.20",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "amqplib": "^0.10.5",
    "ioredis": "^5.4.2",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/express": "^5.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/pg": "^8.11.0",
    "@types/amqplib": "^0.10.5",
    "@types/jest": "^29.5.14",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "supertest": "^7.0.0",
    "typescript": "^5.7.2",
    "tsx": "^4.19.0"
  }
}
