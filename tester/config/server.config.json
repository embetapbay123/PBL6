{
  "$comment": "CẤU HÌNH TRUNG TÂM CHO TOÀN BỘ BỘ KIỂM THỬ. Xem tester/HUONG_DAN_DOI_CAU_HINH.md trước khi sửa.",
  "version": 2,
  "activeTarget": "demo",
  "targets": {
    "demo": {
      "label": "Server demo Internet (demo.congnguyen.me)",
      "webBaseUrl": "https://demo.congnguyen.me",
