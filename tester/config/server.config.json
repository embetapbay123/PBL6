    },
    "customerB": {
      "label": "Khách hàng B",
      "email": "customer.b@pbl6.test",
      "demoAccount": "customerB",
      "password": "",
      "passwordEnv": "SEED_PASSWORD",
      "passwordFile": "infrastructure/.env"
    },
    "owner": {
      "label": "Chủ cửa hàng A",
      "email": "owner.a@pbl6.test",
      "demoAccount": "ownerA",
      "password": "",
      "passwordEnv": "SEED_PASSWORD",
      "passwordFile": "infrastructure/.env"
    },
    "staff": {
      "label": "Nhân viên bán hàng A",
      "email": "seller.a@pbl6.test",
      "demoAccount": "staffA",
      "password": "",
      "passwordEnv": "SEED_PASSWORD",
      "passwordFile": "infrastructure/.env"
    },
    "admin": {
      "label": "Quản trị viên",
      "email": "admin@pbl6.test",
      "demoAccount": "admin",
      "password": "",
