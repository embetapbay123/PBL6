  "unit": {
    "suiteFiles": [
      "tests/unit/auth.guard.test.ts",
      "tests/unit/auth.service.test.ts",
      "tests/unit/audit-log.test.ts",
      "tests/unit/cart.test.ts",
      "tests/unit/security.test.ts",
      "tests/unit/order.test.ts",
      "tests/unit/voucher.test.ts",
      "tests/unit/shipping.test.ts",
      "tests/unit/inventory-reservation.test.ts",
      "tests/unit/reviews.test.ts",
      "tests/unit/search.test.ts",
      "tests/unit/checkout-source.test.ts",
      "tests/unit/logout-session.test.ts",
      "tests/unit/rate-budget.test.ts"
