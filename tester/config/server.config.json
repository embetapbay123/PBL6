      "origin": "https://demo.congnguyen.me",
      "k6BaseUrl": "https://demo.congnguyen.me"
    },
    "local": {
      "label": "Máy local (Docker Compose, cổng 8080)",
      "webBaseUrl": "http://localhost:8080",
      "apiBaseUrl": "http://localhost:8080/api/v1",
      "origin": "https://demo.congnguyen.me",
      "k6BaseUrl": "http://host.docker.internal:8080"
    }
  },
  "http": {
    "timeoutMs": 15000,
    "retries": 1,
    "testTimeoutMs": 60000
  },
  "accounts": {
