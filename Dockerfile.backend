FROM node:22.15.1-bookworm-slim AS build

WORKDIR /app/backend

COPY backend/package.json backend/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY backend/ ./
RUN npm run build

FROM node:22.15.1-bookworm-slim AS production-dependencies

WORKDIR /app/backend

COPY backend/package.json backend/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund && npm cache clean --force

FROM node:22.15.1-bookworm-slim AS runtime

WORKDIR /app/backend

ENV NODE_ENV=production
ENV SERVICE_ID=M3
ENV PORT=3103

COPY --from=production-dependencies /app/backend/node_modules ./node_modules
COPY --from=build /app/backend/dist ./dist

# TypeScript does not copy JSON files imported with resolveJsonModule.
COPY backend/shared/src/*.json ./dist/shared/src/

USER node

EXPOSE 3103

CMD ["node", "dist/identity-store-service/src/main.js"]
