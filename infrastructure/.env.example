# Run python scripts/setup_local.py to create .env and RSA keys locally; do not commit .env.
POSTGRES_PASSWORD=GENERATED_LOCALLY
M1_DB_PASSWORD=GENERATED_LOCALLY
M2_DB_PASSWORD=GENERATED_LOCALLY
M3_DB_PASSWORD=GENERATED_LOCALLY
M3_TEST_DB_PASSWORD=GENERATED_LOCALLY
M4_DB_PASSWORD=GENERATED_LOCALLY
RABBIT_PASSWORD=GENERATED_LOCALLY
M1_INTERNAL_KEY=GENERATED_LOCALLY
M2_INTERNAL_KEY=GENERATED_LOCALLY
M3_INTERNAL_KEY=GENERATED_LOCALLY
M4_INTERNAL_KEY=GENERATED_LOCALLY
SEED_PASSWORD=GENERATED_LOCALLY
WEB_ORIGIN=http://localhost:8080
# Required by M3 for registration and password-reset delivery (implicit TLS SMTP).
# Use mock only for local development; it deliberately sends no email.
EMAIL_ADAPTER=mock
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SITE_ADDRESS=:80
GATEWAY_HTTP_BIND=127.0.0.1:8080
# Trust only the exact peer of a tunnel reaching a loopback-bound origin. Keep the default for direct local use.
EDGE_TRUSTED_PROXY_CIDRS=127.0.0.1/32 ::1/128
EDGE_DOCUMENT_BURST=10
EDGE_DOCUMENT_PER_MINUTE=60
EDGE_API_BURST=40
EDGE_API_PER_MINUTE=240
EDGE_LOGIN_BURST=5
EDGE_LOGIN_PER_MINUTE=20
EDGE_SEARCH_BURST=20
EDGE_SEARCH_PER_MINUTE=90
COOKIE_SECURE=false
SANDBOX_WEBHOOK_SECRET=
SEPAY_WEBHOOK_SECRET=
SEPAY_API_TOKEN=
SEPAY_TEST_ACCOUNT=
SEPAY_TEST_BANK=
# QR instructions only; disabled until an explicit SePay test account is configured.
PAYMENT_PROVIDER_MODE=disabled
OPENAI_API_KEY=
# Direct OpenAI image edits. Disabled unless the flag, key, signing secret and both budgets are configured.
TRY_ON_ENABLED=0
TRY_ON_DEMO_MODE=0
# Server-side PBKDF2 hash, stored as a single-quoted .env value; never put the demo password in frontend code.
TRY_ON_DEMO_PASSWORD_HASH=
TRY_ON_SIGNING_KEY=
# USD micro-units: 1000000 = $1. Zero budgets disable creating images.
TRY_ON_DAILY_BUDGET_MICRO_USD=0
TRY_ON_MONTHLY_BUDGET_MICRO_USD=0
# Conservative per-job hold, not a fixed image price. Unknown calls retain this hold.
TRY_ON_RESERVATION_MICRO_USD=250000
TRY_ON_USER_DAILY_LIMIT=3
TRY_ON_DAILY_REQUEST_LIMIT=50
TRY_ON_MONTHLY_REQUEST_LIMIT=500
TRY_ON_IP_DAILY_LIMIT=30
TRY_ON_CONCURRENCY=2
TRY_ON_RETENTION_HOURS=24
TRY_ON_TIMEOUT_SECONDS=120
TRY_ON_IMAGE_HOSTS=demo.congnguyen.me
AI_MODE=mock
# Explicit opt-in: AI_MODE=real enables database-backed M4; no model call by default.
CHAT_PROVIDER=none
# ollama or openai_compatible; API mode requires HTTPS, model and CHAT_API_KEY.
# OpenCode example base: https://opencode.ai/inference/openai/v1
# Use the exact model ID available to your account; no guessed default model.
CHAT_MODEL_URL=
CHAT_MODEL=
CHAT_API_KEY=
# json_object for compatible providers; json_schema only if supported by the model.
CHAT_RESPONSE_FORMAT=json_object
# DeepSeek compatible APIs only: auto omits the vendor extension; disabled avoids reasoning.
CHAT_THINKING=auto
# Overall model deadline in seconds, >0 and <=30. Internal service deadlines stay unchanged.
CHAT_TIMEOUT_SECONDS=2
# Per-account/day allowances. Demo can raise these without disabling bounded usage.
CHAT_DAILY_REQUEST_LIMIT=100
CHAT_DAILY_TOKEN_LIMIT=100000
# setup_local.py sets these to the Linux key owner's IDs; Windows uses 1000.
LOCAL_UID=1000
LOCAL_GID=1000
SHIPPING_ENABLED=0
GHN_ENVIRONMENT=staging
GHN_ACCOUNT_KEY=platform
GHN_TOKEN=
GHN_WEBHOOK_SECRET=
# Enable only after validating is_cod_collected + cod_collect_date with your account.
GHN_VERIFY_COD_COLLECTION=0
DELIVERY_DB_PASSWORD=GENERATED_LOCALLY
DELIVERY_API_KEY=GENERATED_LOCALLY
DELIVERY_OPERATOR_PASSWORD=GENERATED_LOCALLY
DELIVERY_SESSION_KEY=GENERATED_LOCALLY
DELIVERY_WEBHOOK_SECRET=GENERATED_LOCALLY
DELIVERY_COOKIE_SECURE=0
