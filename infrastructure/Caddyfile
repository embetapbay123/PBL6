{
  servers {
    trusted_proxies static {$EDGE_TRUSTED_PROXY_CIDRS:127.0.0.1/32 ::1/128}
    trusted_proxies_strict
    client_ip_headers CF-Connecting-IP
  }
}
{$SITE_ADDRESS:80} {
  # BEGIN PBL6 EDGE GUARD
  @edgeGuarded {
    not path /assets/* /catalog/* /favicon.ico /robots.txt /site.webmanifest /internal/* /health/* /metrics
  }
  forward_auth @edgeGuarded edge-guard:3111 {
    uri /check
    header_up X-Edge-Client-IP {client_ip}
    header_up X-Edge-Method {method}
    header_up X-Edge-Uri {uri}
    header_up -Authorization
    header_up -Cookie
    header_up -X-Try-On-Demo-Password
    header_up -X-Service-*
    transport http {
      dial_timeout 2s
      response_header_timeout 2s
    }
  }
  # END PBL6 EDGE GUARD

  handle_path /delivery/* {
    reverse_proxy delivery:3110
  }
  @private path /internal/* /health/* /metrics
  handle @private {
    respond "Not found" 404
  }
  @publicStore path_regexp publicStore ^/api/v1/stores/[^/]+$
  handle @publicStore {
    reverse_proxy m3:3103 {
      header_up X-Forwarded-For {client_ip}
      header_up X-PBL6-Client-IP {client_ip}
    }
  }
  @identity path /api/v1/admin/audit/identity /api/v1/admin/audit/actors /api/v1/store/audit/identity /api/v1/store/audit/actors /api/v1/auth/* /api/v1/me /api/v1/me/context /api/v1/me/addresses* /api/v1/me/store-applications* /api/v1/me/invitations* /api/v1/me/conversations* /api/v1/store /api/v1/store/staff* /api/v1/store/conversations* /api/v1/admin/users* /api/v1/admin/stores* /api/v1/admin/roles* /api/v1/admin/store-applications*
  handle @identity {
    reverse_proxy m3:3103 {
      header_up X-Forwarded-For {client_ip}
      header_up X-PBL6-Client-IP {client_ip}
    }
  }
  @ai path /api/v1/chat/* /api/v1/me/chat/* /api/v1/recommendations/* /api/v1/products/*/related /api/v1/ai/* /api/v1/me/personalization-consent
  handle @ai {
    reverse_proxy m4:3104 {
      header_up X-Forwarded-For {client_ip}
      header_up X-PBL6-Client-IP {client_ip}
    }
  }
  @catalog path /api/v1/admin/audit/catalog /api/v1/store/audit/catalog /api/v1/products* /api/v1/categories* /api/v1/product-types* /api/v1/stores/*/products /api/v1/store/products* /api/v1/store/inventory* /api/v1/me/reviews* /api/v1/me/favorites* /api/v1/admin/reviews* /api/v1/admin/products* /api/v1/admin/categories* /api/v1/admin/product-types* /api/v1/admin/attribute-definitions*
  handle @catalog {
    reverse_proxy m1:3101 {
      header_up X-Forwarded-For {client_ip}
      header_up X-PBL6-Client-IP {client_ip}
    }
  }
  handle /api/v1/* {
    reverse_proxy m2:3102 {
      header_up X-Forwarded-For {client_ip}
      header_up X-PBL6-Client-IP {client_ip}
    }
  }
  # Internal endpoints, metrics and health have no public route.
  handle {
    reverse_proxy web:3000
  }
}
